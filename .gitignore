/GAPartNet/**/*.egg-info/
/GAPartNet/**/*.egg-info/**
/GAPartNet/demo.ipynb
!/GAPartNet/**/.gitkeep
!/GAPartNet/**/README.md
!/GAPartNet/**/.gitignore

# Keep lightweight reusable experiment launchers.
!/pull-push/scripts/experiments/
