# ============================================================
# /data/dyj/zts GitHub core-code whitelist
# Goal: upload only core code from:
#   - pull-push
#   - main_table_worktrees
# Everything else is ignored by default.
# ============================================================

# Ignore everything first
*

# Keep root git metadata files
!/.gitignore
!/README.md
!/PROJECT_LAYOUT.md
!/LICENSE
!/LICENSE.*

# Whitelist the two core code trees
!/pull-push/
!/pull-push/**
!/main_table_worktrees/
!/main_table_worktrees/**
!/GAPartNet/
!/GAPartNet/**

# ------------------------------------------------------------
# Global noise / VCS / caches
# ------------------------------------------------------------
**/.git/
**/.git/**
**/__pycache__/
**/__pycache__/**
**/.pytest_cache/
**/.pytest_cache/**
**/.mypy_cache/
**/.mypy_cache/**
**/.ruff_cache/
**/.ruff_cache/**
**/.cache/
**/.cache/**
**/wandb/
**/wandb/**
**/.vscode/
**/.vscode/**
**/.idea/
**/.idea/**

# ------------------------------------------------------------
# Experiment outputs / data / large assets
# ------------------------------------------------------------
**/assets/
**/assets/**
**/dataset/
**/dataset/**
**/datasets/
**/datasets/**
**/data/
**/data/**
**/clean_data/
**/clean_data/**
